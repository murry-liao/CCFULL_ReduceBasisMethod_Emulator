# CCFULL-ROM offline training control.
# The first nine records above are the complete CCFULL physical input.
# A rotational target record is E2T,beta2,beta4,beta6,NrotT.
# Relative paths below are resolved from the repository root.

[model]
# Name of the trained model and of its directories in training_data and outputs.
# "auto" derives it from AP,ZP,AT,ZT, for example a16_z8__a154_z62.
model_id = "16O_154Sm_Basis_300"

[data]
experimental_file = "data/experimental/4-final-ngt4/fusion-exp-8.16.62.154-tb-1995-611.txt"
training_root = "emulator/training_data"

[parameter_bounds]
# Equal endpoints fix a parameter, for example beta6 = [0.0, 0.0].
beta2 = [0.300, 0.360]
beta4 = [0.015, 0.095]
beta6 = [0.0, 0.0]
v0 = [165.0, 185.0]
r0 = [0.900, 0.980]
a0 = [1.00, 1.10]

[energy]
# The energy is a model input: any energy in this range can be emulated.
# "experimental": the measured energies, rounded outward to whole MeV.
# "ccfull": Emin and Emax of record 8.  Or an interval, for example [52.0, 100.0].
range = "experimental"

[wave_pod]
# Snapshots (training data): Latin-hypercube points in
# (beta2, beta4, beta6, V0, r0, a0, E, J), one exact CCFULL solve each.
# J is drawn uniformly from the partial waves CCFULL needs at that energy.
training_points = 4000
# Basis: the number of POD modes kept from the snapshots, at most
# training_points.  Each online (E, J) solve is a rank x rank system.
rank = 300
seed = 20261103
# CCFULL processes that solve snapshots at the same time.
workers = 1

[cc_eim]
# Multipole CC-EIM of the coupling field, trained from potential evaluations.
interaction_points = 200
seed = 20261101
tolerance = 1.0e-5
max_rank_per_multipole = 20
